{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Awesome Kindle resources index",
  "type": "object",
  "required": ["repo", "generated", "source", "count", "items"],
  "properties": {
    "repo": { "type": "string" },
    "generated": { "type": "string" },
    "source": { "type": "string" },
    "count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url", "links", "description", "section", "kind"],
        "properties": {
          "name": { "type": "string" },
          "name_zh": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://" },
          "links": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "description_zh": { "type": "string" },
          "section": { "type": "string" },
          "section_zh": { "type": "string" },
          "subsection": { "type": ["string", "null"] },
          "subsection_zh": { "type": ["string", "null"] },
          "kind": { "enum": ["jailbreak", "resource"] }
        }
      }
    }
  }
}
